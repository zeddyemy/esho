# Copy to .env and fill in. Never commit real values.

# Public site URL (canonical links, Open Graph, sitemap). Production: your domain
VITE_SITE_URL=http://localhost:3100

# Optional: Google Search Console HTML-tag verification code (content="..." value only)
VITE_GOOGLE_SITE_VERIFICATION=

# Show TanStack Router/Query devtools in development
VITE_DEVTOOLS=false

# Supabase (Project Settings > API Keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (sb_secret_...)
SUPABASE_SECRET_KEY=

# Cloudinary (API key/secret are server-only)
VITE_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Protects the cron endpoints (Vercel sends it as a Bearer token). Required for the
# weekly unused-file cleanup (/api/cleanup-media); any long random string.
CRON_SECRET=
